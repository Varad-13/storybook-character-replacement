# Both providers are optional here — the app also accepts a key typed into the
# UI, which is sent per request and never stored server-side. Set these to give
# a deployment a working default so nobody has to paste anything.

# OpenRouter
OPENROUTER_API_KEY=
IMAGE_MODEL=openai/gpt-5.4-image-2

# OpenAI direct. Only this path honours `quality` and `size` as real parameters.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Vision model that reads the book and works out its cast.
VISION_MODEL=google/gemini-2.5-flash
OPENAI_VISION_MODEL=gpt-4o
